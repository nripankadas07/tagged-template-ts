{
  "name": "tagged-template-ts",
  "version": "0.1.0",
  "description": "Type-safe tagged template helpers for TypeScript — html, sql, dedent, oneline, raw, regex, urlPath, csv with a tag() factory.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --coverage"
  },
  "keywords": [
    "tagged-template",
    "template-literal",
    "html",
    "sql",
    "dedent",
    "oneline",
    "regex",
    "typescript",
    "type-safe"
  ],
  "author": "Nripanka Das",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nripankadas07/tagged-template-ts"
  }
}
